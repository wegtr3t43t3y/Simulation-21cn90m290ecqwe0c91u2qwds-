import * as THREE from 'three';
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

const tempRange = document.getElementById('tempRange');
const stirRange = document.getElementById('stirRange');
const catalystRange = document.getElementById('catalystRange');
const pressureValue = document.getElementById('pressureValue');
const yieldValue = document.getElementById('yieldValue');
const reactionTitle = document.getElementById('reactionTitle');
const reactionDesc = document.getElementById('reactionDesc');
const toggleSceneBtn = document.getElementById('toggleScene');
const toolCards = document.querySelectorAll('.tool-card');
const reactionButtons = document.querySelectorAll('.reaction-btn');

const presets = {
  synthesis: {
    name: 'Synthesis',
    desc: 'Molecular assembly is proceeding with high-energy transfer and stable output.',
    temperature: 72,
    agitation: 68,
    catalyst: 46,
    colors: ['#64d6ff', '#7ef0c5', '#8a7cff'],
  },
  crystal: {
    name: 'Crystallization',
    desc: 'Particle ordering is accelerating as ordered lattices nucleate and expand.',
    temperature: 48,
    agitation: 42,
    catalyst: 58,
    colors: ['#75e3ff', '#d9d0ff', '#9de9cd'],
  },
  combustion: {
    name: 'Combustion',
    desc: 'Rapid oxidation is producing luminous, high-velocity reaction fronts.',
    temperature: 89,
    agitation: 74,
    catalyst: 34,
    colors: ['#ffbf69', '#ff7d5c', '#ff6d72'],
  },
  catalytic: {
    name: 'Catalytic',
    desc: 'The catalyst is lowering activation energy while maintaining sustained orbital flow.',
    temperature: 64,
    agitation: 58,
    catalyst: 82,
    colors: ['#7ef0c5', '#64d6ff', '#d4b8ff'],
  },
};

let currentPreset = 'synthesis';
let animationPaused = false;
let scene, camera, renderer, controls;
let vesselGroup;
let particleSystem;
let particlesColors = [];

const root = document.getElementById('scene-root');

function setPreset(presetKey) {
  const preset = presets[presetKey];
  if (!preset) return;

  currentPreset = presetKey;
  tempRange.value = preset.temperature;
  stirRange.value = preset.agitation;
  catalystRange.value = preset.catalyst;

  reactionTitle.textContent = preset.name;
  reactionDesc.textContent = preset.desc;

  reactionButtons.forEach((button) => {
    button.classList.toggle('active', button.dataset.preset === presetKey);
  });

  document.documentElement.style.setProperty('--reaction-color-1', preset.colors[0]);
  document.documentElement.style.setProperty('--reaction-color-2', preset.colors[1]);
  document.documentElement.style.setProperty('--reaction-color-3', preset.colors[2]);

  updateMetrics();
  updateReactionState();
}

function updateMetrics() {
  const temp = Number(tempRange.value);
  const stir = Number(stirRange.value);
  const catalyst = Number(catalystRange.value);

  const pressure = (temp / 42 + stir / 76 + catalyst / 68) / 1.5;
  const yield = (temp * 0.4 + stir * 0.28 + catalyst * 0.32) / 1.8;

  pressureValue.textContent = `${pressure.toFixed(1)} bar`;
  yieldValue.textContent = `${yield.toFixed(1)}%`;

  if (vesselGroup) {
    const fluid = vesselGroup.userData.fluid;
    const glow = vesselGroup.userData.glow;

    const hueMix = (temp / 100) * 0.28 + (catalyst / 100) * 0.12;
    const fluidColor = new THREE.Color().setHSL(0.55 + hueMix, 0.78, 0.62);
    fluid.material.color.copy(fluidColor);
    fluid.material.emissive.copy(fluidColor).multiplyScalar(0.65);
    glow.material.color.copy(fluidColor);
    glow.material.opacity = 0.28 + catalyst / 200;
  }
}

function createLabEnvironment() {
  scene = new THREE.Scene();
  scene.background = new THREE.Color(0x06151e);
  scene.fog = new THREE.Fog(0x06151e, 22, 50);

  camera = new THREE.PerspectiveCamera(45, root.clientWidth / root.clientHeight, 0.1, 100);
  camera.position.set(8, 6, 10);

  renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(root.clientWidth, root.clientHeight);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  root.appendChild(renderer.domElement);

  controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.enablePan = false;
  controls.minDistance = 8;
  controls.maxDistance = 18;
  controls.maxPolarAngle = Math.PI * 0.48;
  controls.target.set(0, 2.2, 0);

  const ambient = new THREE.AmbientLight(0xbcd9ff, 1.2);
  scene.add(ambient);

  const keyLight = new THREE.DirectionalLight(0xc7eeff, 1.9);
  keyLight.position.set(7, 11, 5);
  scene.add(keyLight);

  const rimLight = new THREE.PointLight(0x7cc8ff, 22, 24, 2);
  rimLight.position.set(-6, 7, 3);
  scene.add(rimLight);

  const floor = new THREE.Mesh(
    new THREE.CylinderGeometry(12, 12, 0.9, 64),
    new THREE.MeshStandardMaterial({ color: 0x0d2836, metalness: 0.25, roughness: 0.9 })
  );
  floor.position.y = -0.7;
  scene.add(floor);

  const roomRing = new THREE.Mesh(
    new THREE.TorusGeometry(11.4, 0.12, 12, 120),
    new THREE.MeshBasicMaterial({ color: 0x7fcfff, transparent: true, opacity: 0.25 })
  );
  roomRing.rotation.x = Math.PI / 2;
  roomRing.position.y = -0.15;
  scene.add(roomRing);

  const wallMaterial = new THREE.MeshStandardMaterial({ color: 0x0b1f2a, roughness: 1, metalness: 0.15 });
  const backWall = new THREE.Mesh(new THREE.BoxGeometry(18, 10, 0.5), wallMaterial);
  backWall.position.set(0, 4, -9);
  scene.add(backWall);

  const sideWallLeft = new THREE.Mesh(new THREE.BoxGeometry(0.5, 10, 18), wallMaterial);
  sideWallLeft.position.set(-9, 4, 0);
  scene.add(sideWallLeft);

  const sideWallRight = sideWallLeft.clone();
  sideWallRight.position.x = 9;
  scene.add(sideWallRight);

  const benchMaterial = new THREE.MeshStandardMaterial({ color: 0x243d49, metalness: 0.28, roughness: 0.95 });
  const benchGeo = new THREE.BoxGeometry(4.5, 0.5, 1.6);
  const benchLeft = new THREE.Mesh(benchGeo, benchMaterial);
  benchLeft.position.set(-4.2, 1.1, 4.6);
  scene.add(benchLeft);

  const benchRight = benchLeft.clone();
  benchRight.position.x = 4.2;
  scene.add(benchRight);

  const cabinetGeo = new THREE.BoxGeometry(1.6, 2.1, 1.5);
  const cabinetMat = new THREE.MeshStandardMaterial({ color: 0x1a2f3d, roughness: 0.8, metalness: 0.4 });

  for (const x of [-5.8, 5.8]) {
    const cabinet = new THREE.Mesh(cabinetGeo, cabinetMat);
    cabinet.position.set(x, 1.1, 5.8);
    scene.add(cabinet);
  }

  const monitorMat = new THREE.MeshStandardMaterial({ color: 0x122a37, emissive: 0x4dc0ff, emissiveIntensity: 0.4 });
  const monitorGeo = new THREE.BoxGeometry(1.2, 0.9, 0.2);
  const monitorLeft = new THREE.Mesh(monitorGeo, monitorMat);
  monitorLeft.position.set(-2.8, 2.2, 5.7);
  scene.add(monitorLeft);

  const monitorRight = monitorLeft.clone();
  monitorRight.position.x = 2.8;
  scene.add(monitorRight);

  const shelfGeo = new THREE.BoxGeometry(2.7, 0.22, 0.9);
  const shelfMat = new THREE.MeshStandardMaterial({ color: 0x2f495c, roughness: 0.7, metalness: 0.5 });
  for (const y of [2.4, 3.3]) {
    const shelf = new THREE.Mesh(shelfGeo, shelfMat);
    shelf.position.set(-4.2, y, -2.2);
    scene.add(shelf);
    const shelf2 = shelf.clone();
    shelf2.position.x = 4.2;
    scene.add(shelf2);
  }

  vesselGroup = new THREE.Group();
  scene.add(vesselGroup);

  const vesselGlass = new THREE.Mesh(
    new THREE.CylinderGeometry(1.5, 1.5, 2.5, 40, 1, true),
    new THREE.MeshPhysicalMaterial({
      color: 0x7ecbff,
      transmission: 0.8,
      transparent: true,
      opacity: 0.18,
      roughness: 0.2,
      metalness: 0.1,
      thickness: 0.8,
      clearcoat: 1,
      clearcoatRoughness: 0.2,
    })
  );
  vesselGlass.position.y = 2.5;
  vesselGroup.add(vesselGlass);

  const fluid = new THREE.Mesh(
    new THREE.CylinderGeometry(1.32, 1.32, 1.8, 40),
    new THREE.MeshStandardMaterial({
      color: new THREE.Color('#64d6ff'),
      emissive: new THREE.Color('#64d6ff'),
      emissiveIntensity: 0.6,
      transparent: true,
      opacity: 0.9,
      roughness: 0.2,
      metalness: 0.15,
    })
  );
  fluid.position.y = 1.7;
  vesselGroup.add(fluid);

  const glow = new THREE.Mesh(
    new THREE.SphereGeometry(1.85, 32, 32),
    new THREE.MeshBasicMaterial({
      color: new THREE.Color('#64d6ff'),
      transparent: true,
      opacity: 0.18,
      side: THREE.DoubleSide,
    })
  );
  glow.position.y = 2.1;
  vesselGroup.add(glow);

  vesselGroup.position.set(0, 0.2, 0);
  vesselGroup.userData = { fluid, glow };

  const reactorStand = new THREE.Mesh(
    new THREE.CylinderGeometry(0.8, 0.85, 0.6, 32),
    new THREE.MeshStandardMaterial({ color: 0x3e5869, metalness: 0.45, roughness: 0.7 })
  );
  reactorStand.position.y = 0.58;
  vesselGroup.add(reactorStand);

  const pipeMat = new THREE.MeshStandardMaterial({ color: 0x1d3647, metalness: 0.3, roughness: 0.8 });
  const pipeA = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 3, 18), pipeMat);
  pipeA.rotation.z = Math.PI / 2.2;
  pipeA.position.set(-2.3, 2.1, 0.5);
  scene.add(pipeA);

  const pipeB = pipeA.clone();
  pipeB.position.set(2.3, 2.1, -0.4);
  scene.add(pipeB);

  createParticles();
}

function createParticles() {
  const count = 550;
  const positions = new Float32Array(count * 3);
  const colors = new Float32Array(count * 3);

  for (let i = 0; i < count; i++) {
    const theta = Math.random() * Math.PI * 2;
    const radius = 0.8 + Math.random() * 1.4;
    positions[i * 3] = Math.cos(theta) * radius;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 2.5;
    positions[i * 3 + 2] = Math.sin(theta) * radius;

    const color = new THREE.Color(presets.synthesis.colors[Math.floor(Math.random() * presets.synthesis.colors.length)]);
    colors[i * 3] = color.r;
    colors[i * 3 + 1] = color.g;
    colors[i * 3 + 2] = color.b;
  }

  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const mat = new THREE.PointsMaterial({
    size: 0.08,
    transparent: true,
    opacity: 0.95,
    vertexColors: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
  });

  particleSystem = new THREE.Points(geo, mat);
  particleSystem.position.y = 2.3;
  scene.add(particleSystem);
  particlesColors = colors.slice();
}

function updateReactionState() {
  const preset = presets[currentPreset];
  const colorA = new THREE.Color(preset.colors[0]);
  const colorB = new THREE.Color(preset.colors[1]);
  const colorC = new THREE.Color(preset.colors[2]);

  if (particleSystem) {
    const positions = particleSystem.geometry.attributes.position.array;
    const colors = particleSystem.geometry.attributes.color.array;
    const base = preset.colors;

    for (let i = 0; i < positions.length / 3; i++) {
      const hue = base[i % base.length];
      const c = new THREE.Color(hue);
      colors[i * 3] = c.r;
      colors[i * 3 + 1] = c.g;
      colors[i * 3 + 2] = c.b;
    }

    particleSystem.geometry.attributes.color.needsUpdate = true;
  }

  const glowColor = new THREE.Color(preset.colors[0]);
  if (vesselGroup) {
    vesselGroup.userData.glow.material.color.copy(glowColor);
    vesselGroup.userData.fluid.material.color.copy(glowColor);
    vesselGroup.userData.fluid.material.emissive.copy(glowColor);
  }

  const flash = new THREE.PointLight(glowColor, 18, 15, 2);
  flash.position.set(0, 4.2, 0);
  scene.add(flash);
  setTimeout(() => scene.remove(flash), 350);
}

function animateParticles() {
  if (!particleSystem || animationPaused) return;

  const positions = particleSystem.geometry.attributes.position.array;
  const temp = Number(tempRange.value);
  const stir = Number(stirRange.value);
  const catalyst = Number(catalystRange.value);
  const preset = presets[currentPreset];

  for (let i = 0; i < positions.length; i += 3) {
    const theta = (i * 0.13) + performance.now() * 0.0007;
    positions[i] += Math.cos(theta + i) * 0.0022 + (stir - 50) * 0.00004;
    positions[i + 1] += (Math.random() - 0.5) * 0.012 + (temp - 50) * 0.00008;
    positions[i + 2] += Math.sin(theta + i) * 0.0022 + (catalyst - 50) * 0.00004;

    const radius = 0.8 + Math.sin(i + performance.now() * 0.001) * 0.3;
    const dist = Math.sqrt(positions[i] ** 2 + positions[i + 2] ** 2);

    if (dist > radius + 0.8 || dist < radius - 0.8) {
      const angle = Math.random() * Math.PI * 2;
      positions[i] = Math.cos(angle) * (0.8 + Math.random() * 1.2);
      positions[i + 2] = Math.sin(angle) * (0.8 + Math.random() * 1.2);
      positions[i + 1] = (Math.random() - 0.5) * 2.6;
    }
  }

  particleSystem.geometry.attributes.position.needsUpdate = true;
  particleSystem.rotation.y += 0.003 + stir * 0.00017;
  particleSystem.rotation.x = Math.sin(performance.now() * 0.0009) * 0.2;

  if (vesselGroup) {
    const fluid = vesselGroup.userData.fluid;
    const pulsate = 1 + Math.sin(performance.now() * 0.0035) * 0.12 + (temp / 1000);
    fluid.scale.y = pulsate;
    fluid.position.y = 1.7 + Math.sin(performance.now() * 0.004) * 0.06;
  }
}

function setupUI() {
  tempRange.addEventListener('input', updateMetrics);
  stirRange.addEventListener('input', updateMetrics);
  catalystRange.addEventListener('input', updateMetrics);

  toolCards.forEach((card) => {
    card.addEventListener('click', () => {
      toolCards.forEach((item) => item.classList.toggle('active', item === card));
    });
  });

  reactionButtons.forEach((button) => {
    button.addEventListener('click', () => setPreset(button.dataset.preset));
  });

  toggleSceneBtn.addEventListener('click', () => {
    animationPaused = !animationPaused;
    toggleSceneBtn.textContent = animationPaused ? 'Resume' : 'Pause';
  });
}

function resizeRenderer() {
  if (!renderer || !camera) return;

  const { clientWidth, clientHeight } = root;
  camera.aspect = clientWidth / clientHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(clientWidth, clientHeight);
}

function renderFrame() {
  requestAnimationFrame(renderFrame);

  if (!animationPaused) {
    animateParticles();
  }

  if (controls) {
    controls.update();
  }

  if (renderer && scene && camera) {
    renderer.render(scene, camera);
  }
}

function init() {
  createLabEnvironment();
  setupUI();
  updateMetrics();
  setPreset(currentPreset);
  window.addEventListener('resize', resizeRenderer);
  renderFrame();
}

init();
